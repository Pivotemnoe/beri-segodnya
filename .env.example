SITE_ACCESS_ENABLED=true
APP_ENV=development
APP_BASE_URL=http://localhost:3010
APP_DOMAIN=localhost
PORT=3010
HOST=127.0.0.1
TRUST_PROXY=false
SESSION_SECRET=replace_with_random_long_secret

SITE_ACCESS_USER=demo
SITE_ACCESS_PASSWORD_SHA256=replace_with_sha256_hash

ADMIN_ACCESS_ENABLED=false
ADMIN_ACCESS_USER=admin
ADMIN_ACCESS_PASSWORD_SHA256=replace_with_sha256_hash
ADMIN_APP_LOGIN=admin
ADMIN_APP_PASSWORD_HASH=replace_with_pbkdf2_hash
ADMIN_APP_PASSWORD_SALT=replace_with_pbkdf2_salt
ADMIN_APP_PASSWORD_ITERATIONS=600000

PARTNER_ACCESS_ENABLED=false
PARTNER_ACCESS_USER=partner
PARTNER_ACCESS_PASSWORD_SHA256=replace_with_sha256_hash

DB_DRIVER=json
DB_FILE=data/db.json
UPLOAD_DIR=data/uploads

# Required only when intentionally creating/resetting demo seed data.
SEED_PARTNER_1_PASSWORD=replace_with_unique_random_password
SEED_PARTNER_2_PASSWORD=replace_with_unique_random_password
SEED_PARTNER_3_PASSWORD=replace_with_unique_random_password

# Public personal-data forms stay closed until every legal field is complete.
